[configuration]

entry_symbol = "hop_physics_library_init"
compatibility_minimum = "4.1"
# NOT reloadable: hot-reloading recreates the live HopPhysicsServer, and the old
# instance's ~PhysicsServer3D nulls Godot's PhysicsServer3D singleton — the engine
# then crashes on the next physics frame. Rebuilds need an editor restart.
reloadable = false

[libraries]

macos.debug.arm64 = "res://addons/hop-physics/bin/libhop-physics.macos.template_release.arm64.dylib"
macos.release.arm64 = "res://addons/hop-physics/bin/libhop-physics.macos.template_release.arm64.dylib"
macos.debug.x86_64 = "res://addons/hop-physics/bin/libhop-physics.macos.template_release.x86_64.dylib"
macos.release.x86_64 = "res://addons/hop-physics/bin/libhop-physics.macos.template_release.x86_64.dylib"
windows.debug.x86_64 = "res://addons/hop-physics/bin/libhop-physics.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://addons/hop-physics/bin/libhop-physics.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/hop-physics/bin/libhop-physics.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://addons/hop-physics/bin/libhop-physics.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/hop-physics/bin/libhop-physics.linux.template_release.arm64.so"
linux.release.arm64 = "res://addons/hop-physics/bin/libhop-physics.linux.template_release.arm64.so"
